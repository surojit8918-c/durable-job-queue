# Environment Configuration
APP_ENV=development

# PostgreSQL Connection (local development uses localhost; docker uses db:5432)
DATABASE_URL=postgresql+psycopg://postgres:12345678@localhost:5432/job_queue
TEST_DATABASE_URL=postgresql+psycopg://postgres:12345678@localhost:5432/job_queue_test

# Worker Configuration
WORKER_ID=worker-1
WORKER_POLL_INTERVAL=1.0

# Lease and Timeout Configuration
LEASE_DURATION_SECONDS=60
LEASE_RENEWAL_INTERVAL_SECONDS=15
HANDLER_TIMEOUT_SECONDS=30
GRACEFUL_SHUTDOWN_SECONDS=35

# HTTP Client Timeouts
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20

# Retry Configuration
MAX_JOB_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=60.0

# Partner API Configuration (leave empty to use built-in mock adapter)
PARTNER_API_BASE_URL=
PARTNER_API_KEY=
